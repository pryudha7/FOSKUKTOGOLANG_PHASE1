# Development values. Every key is required (SoT ENV-006); there are no defaults.
APP_ENV=development
LISTEN_ADDR=:8080
DATABASE_URL=postgres://fos:fos@localhost:5432/fos?sslmode=disable
LOGIN_PATH_DB=/PRWebDB1
LOGIN_PATH_LDAP=/PRWebLDAP1
ENDPOINT_PATH_DESKTOP=/app/fossyariah
# Reverse proxies allowed to assert HTTPS via X-Forwarded-Proto (the Next.js server in development).
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# LDAP login (SoT §4.2). If any of these is empty, LDAP login is refused with
# ERR-002 and the Database path keeps working (ENV-008).
LDAP_URL=ldap://AD-DEV.banksinarmas.com
LDAP_BIND_DN=CN=adpegafos,OU=Functional ID - System,OU=Account,DC=banksinarmas,DC=com
# Secret (ENV-007): inject from the deployment's secret store; never commit a value.
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=banksinarmas,DC=com
LDAP_SEARCH_FILTER=SamAccountName=%v
LDAP_TIMEOUT_SECONDS=10
